{
  "manifest_version": 3,
  "name": "Từ Điển Ả Rập - Việt",
  "version": "1.3.0",
  "description": "Select any text to translate between Arabic and Vietnamese, look words up in the dictionary and hear them pronounced.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "offscreen"
  ],
  "host_permissions": [
    "https://your-api-domain.example/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dictionary.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}